# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena lo que tengas.
# Sin ninguna clave, la app funciona igual en MODO DEMO:
# el bot genera propuestas con un motor local y las imágenes
# son fondos generados proceduralmente con la paleta de marca.
# ─────────────────────────────────────────────────────────────

# --- Copy / estrategia (Claude) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# IMÁGENES
# Por defecto NO se genera nada y NO se gasta un céntimo: los fondos
# salen de public/backgrounds/ (ver lib/backgrounds.ts).
#
# Para volver a generar de verdad hay que ponerlo explícitamente:
#   IMAGE_PROVIDER=gemini
# Ojo con el coste por imagen: gemini-3-pro-image es el más caro de la
# familia. Si necesitas generar, gemini-3.1-flash-image cuesta una
# fracción y para un fondo tras un scrim la diferencia apenas se ve.
# ─────────────────────────────────────────────────────────────
IMAGE_PROVIDER=

# --- Solo si pones IMAGE_PROVIDER=gemini ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelos de imagen disponibles (los mejores primero para este caso de uso):
#   gemini-3-pro-image        → Nano Banana Pro. Máxima fidelidad de producto.
#   gemini-3-pro-image-preview
#   gemini-3.1-flash-image    → bastante más barato, buena calidad para borradores
#   gemini-2.5-flash-image    → Nano Banana original
# Para listar los que admite tu clave:
#   curl -s https://generativelanguage.googleapis.com/v1beta/models \
#     -H "x-goog-api-key: $GOOGLE_API_KEY" | grep '"name"'
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# --- Solo si pones IMAGE_PROVIDER=openai ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

